TEAM_ID=
BUNDLE_ID=org.erbeenjoyers.drinkwater.DrinkWater
APP_NAME=Drink Water

// The servers debug and release builds start on. "//" starts a comment in xcconfig files, hence "http:/$()/".
// To use another server, e.g. from a real iPhone, set DEV_SERVER_URL in Local.xcconfig next to this file; it is
// not checked in. Set RELEASE_SERVER_URL there too, e.g. RELEASE_SERVER_URL = https:/$()/drinkwater.example.com;
// without it a release build starts on no server and the user has to pick one on the login screen.
DEV_SERVER_URL = http:/$()/localhost:8080
RELEASE_SERVER_URL =

#include? "Local.xcconfig"
